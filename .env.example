# Development only. Generate production configuration with tools/production_init.py.
APP_ENV=development
RUNTIME_ROLE=api
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
RATE_LIMIT_BACKEND=memory
TRUSTED_PROXY_IPS=
POSTGRES_DB=mascomatch
POSTGRES_USER=mascomatch
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://mascomatch:change-me-locally@db:5432/mascomatch
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
GEOCODER_BASE_URL=https://photon.komoot.io
NEXT_PUBLIC_SEARCH_COUNTRY=UY
MINIO_ROOT_USER=mascomatch
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=pet-photos
S3_ACCESS_KEY=mascomatch
S3_SECRET_KEY=change-this-minio-password
MAX_PHOTO_SIZE_BYTES=10485760

# One-time hosted Mercado Pago checkout. Keep disabled until test credentials and HTTPS callbacks are configured.
MP_ENABLED=false
MP_ENVIRONMENT=test
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_APPLICATION_ID=
MP_PUBLIC_BASE_URL=
RATE_LIMIT_DONATION=6
RATE_LIMIT_PAYMENT_WEBHOOK=180

# Local AI. No API key or paid provider is used.
# First-party product measurements; no external analytics provider.
ANALYTICS_ENABLED=true
RATE_LIMIT_ANALYTICS=120
RATE_LIMIT_ANALYTICS_DAILY=200000
ANALYTICS_VISITOR_DAYS=180
ANALYTICS_SESSION_MINUTES=30
ANALYTICS_RAW_DAYS=90
ANALYTICS_DAILY_DAYS=730
# Set true after downloading the model and start Compose with --profile ai-local.
AI_ENABLED=false
AI_TEXT_MODEL=gemma3:4b
AI_VISION_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://ollama:11434
REDIS_URL=redis://redis:6379/0
AI_TEXT_REQUEST_TIMEOUT_SECONDS=120
AI_VISION_REQUEST_TIMEOUT_SECONDS=240
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_NUM_THREADS=3
OLLAMA_KEEP_ALIVE=15m
OLLAMA_PREWARM=true
OLLAMA_CAPABILITIES_CACHE_SECONDS=3600
VLM_IMAGE_MAX_SIDE=1024
VLM_IMAGE_JPEG_QUALITY=88
AI_MAX_ATTEMPTS=3
AI_DISPATCH_INTERVAL_SECONDS=5

# Linked sightings and conservative semantic photo matching.
LINKED_MATCH_THRESHOLD=0.75
LINKED_FEATURE_CONFIDENCE=0.7
API_INTERNAL_URL=http://api:8000/api/v1

# SMTP credentials are backend-only. No paid account is needed for Brevo Free.
# Set 'smtp' with a verified sender to send real alerts; 'preview' uses local Mailpit.
# Creating accounts requires smtp or preview, to deliver the confirmation link.
MAIL_DELIVERY_MODE=disabled
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MascoMatch <avisos@mascomatch.local>
SMTP_TLS_MODE=starttls
PUBLIC_SITE_URL=http://localhost:3000
# Minutes after publication before checking whether a photo reminder is needed.
PHOTO_REMINDER_DELAY_MINUTES=30

# Local visual matching. Install pinned weights with app.embeddings.setup before enabling.
EMBEDDINGS_ENABLED=false
EMBEDDING_CPU_THREADS=2
EMBEDDING_CACHE_DIR=/models/clip
PET_REID_CACHE_DIR=/models/pet-reid
DETECTOR_CACHE_DIR=/models/detector
PET_REID_ENABLED=true
OPENCLIP_ENABLED=true
PET_CROP_ENABLED=true
PET_CROP_CONFIDENCE=0.75
PET_CROP_MARGIN=0.18
PET_CROP_TIMEOUT_SECONDS=15
EMBEDDING_REQUEST_TIMEOUT_SECONDS=90
OPENCLIP_VISUAL_FLOOR=0.55
OPENCLIP_VISUAL_CEILING=0.95
PET_REID_VISUAL_FLOOR=0.50
PET_REID_VISUAL_CEILING=0.90
VISUAL_BEST_WEIGHT=0.7
MATCHING_ANALYSIS_WAIT_SECONDS=30
MATCHING_NOTIFY_MIN_COVERAGE=0.35
MATCHING_NOTIFY_MIN_FEATURE=0.65
MATCHING_NOTIFY_MIN_GEO=0.35
MATCHING_CANDIDATE_THRESHOLD=0.55
MATCHING_NOTIFY_THRESHOLD=0.82
MATCHING_MAX_RADIUS_METERS=50000
MATCHING_TEMPORAL_DAYS=30
MAIL_GROUP_SECONDS=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=30
# New-account attempts per client address per hour (shared via Redis in production).
RATE_LIMIT_REGISTER=5
# Contact attempts per client address per hour and total per day.
RATE_LIMIT_CONTACT=5
RATE_LIMIT_CONTACT_DAILY=50
RATE_LIMIT_PUBLISH=60
RATE_LIMIT_READ=300

