{
    servers {
        timeouts {
            read_header 10s
            read_body 120s
            idle 120s
        }
    }
}

{$SITE_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 55MB
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    }
    @private path /internal/* /health/ready /api/v1/docs* /api/v1/openapi.json
    handle @private {
        respond 404
    }
    @publicAPI {
        path /api/v1/*
        method GET HEAD
    }
    handle @publicAPI {
        reverse_proxy api:8000 {
            header_up X-MascoMatch-Client-IP {remote_host}
        }
    }
    # Browser writes use the bounded, session-protected Next.js proxies.
    handle /api/v1/* {
        respond 404
    }
    handle /health* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:3000 {
            header_up X-MascoMatch-Client-IP {remote_host}
        }
    }
}
